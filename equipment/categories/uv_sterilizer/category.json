{
  "name": {
    "en": "UV sterilizer",
    "fr": "Stérilisateur UV"
  },
  "scopes": [
    "aquarium",
    "pool"
  ],
  "icon": "mdi:lightbulb-on",
  "maintenance": [
    {
      "task": "uv_lamp_replace",
      "schedule": {
        "type": "interval",
        "unit": "months",
        "every": {
          "default": 1,
          "min": 1,
          "max": 12
        }
      }
    },
    {
      "task": "uv_quartz_clean",
      "schedule": {
        "type": "interval",
        "unit": "months",
        "every": {
          "default": 1,
          "min": 1,
          "max": 12
        }
      }
    }
  ]
}
